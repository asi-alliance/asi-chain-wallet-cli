# Explicit endpoints are preferred; HTTP URLs may include a gateway base path.
VALIDATOR_GRPC_URL=http://127.0.0.1:40412
VALIDATOR_HTTP_URL=http://127.0.0.1:40413
OBSERVER_HTTP_URL=http://127.0.0.1:40453

# Alternatively retain VALIDATOR_HOST + GRPC/HTTP_PORT and OBSERVER_HOST + HTTP_PORT.
# OBSERVER_GRPC_PORT is no longer used; HTTP_PORT must be supplied explicitly.
OUTPUT_DIR=./credentials
EXPECTED_TOKEN_SYMBOL=ASI
SHARD_ID=root
DEPLOY_MAX_WAIT_SECONDS=480
DEPLOY_CHECK_INTERVAL_SECONDS=5
NODE_CONNECT_TIMEOUT_SECONDS=10
NODE_TIMEOUT_SECONDS=30
# NODE_CA_CERT=/protected/path/ca.pem
VERBOSE_LOGS=false

# Required only by history/export. Do not use an admin-secret-bearing public URL.
GRAPHQL_URL=
# Positive seconds: connection acknowledgement and the entire export query.
GRAPHQL_TIMEOUT_SECONDS=30

# Optional integration-test settings (not read automatically from .env).
# Export these in the shell or prefix the cargo test command, for example:
# FIREFLY_PORT_BASE=41400 cargo test --release --features integration --test node_compatibility --locked
# Host port base; default 40400. Valid range: 1024..65473 (reserves 63 ports).
# FIREFLY_PORT_BASE=41400
# Keep the owned test shard running after the test. Unset to enable cleanup;
# any defined value, including 0 or false, keeps the shard running.
# FIREFLY_KEEP_SHARD=1
# Default node image; preserve the reviewed digest for compatibility tests.
# FIREFLY_NODE_IMAGE=amamata/rust-node@sha256:f835f503efbfc27d28025feb2710e3baa07e15e71c9553ac036b4a6d6c4a2eab
# IT_PORT_* mappings are generated from FIREFLY_PORT_BASE in
# target/integration-shard/shard.env; do not set them here.
