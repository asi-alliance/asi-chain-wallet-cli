# Explicit endpoints are preferred; HTTP URLs may include a gateway base path.
VALIDATOR_GRPC_URL=http://127.0.0.1:40412
VALIDATOR_HTTP_URL=http://127.0.0.1:40413
OBSERVER_HTTP_URL=http://127.0.0.1:40453

# Alternatively retain VALIDATOR_HOST + GRPC/HTTP_PORT and OBSERVER_HOST + HTTP_PORT.
# OBSERVER_GRPC_PORT is no longer used; HTTP_PORT must be supplied explicitly.
OUTPUT_DIR=./credentials
EXPECTED_TOKEN_SYMBOL=ASI
SHARD_ID=root
DEPLOY_MAX_WAIT_SECONDS=480
DEPLOY_CHECK_INTERVAL_SECONDS=5
NODE_CONNECT_TIMEOUT_SECONDS=10
NODE_TIMEOUT_SECONDS=30
# NODE_CA_CERT=/protected/path/ca.pem
VERBOSE_LOGS=false

# Required only by history/export. Do not use an admin-secret-bearing public URL.
GRAPHQL_URL=
